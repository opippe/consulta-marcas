# Modelo para Railway. NÃO coloque este arquivo em um projeto Pages.
# Copie os valores para o painel Variables; substitua TODOS os placeholders.
NODE_ENV=production
PORT=3100
DATABASE_URL=postgresql://SUBSTITUA_URL_COM_POOLER_E_SSL
DATABASE_MIGRATION_URL=postgresql://SUBSTITUA_URL_DIRETA_E_SSL
DATABASE_POOL_SIZE=3
INFOSIMPLES_TOKEN=SUBSTITUA
CORS_ORIGINS=https://55marcas.com.br,https://www.55marcas.com.br,https://crm.55marcas.com.br
BETTER_AUTH_URL=https://api.55marcas.com.br
BETTER_AUTH_SECRET=SUBSTITUA
PROPOSAL_LINK_SECRET=SUBSTITUA
RATE_LIMIT_SALT=SUBSTITUA
BETTER_AUTH_ALLOW_SIGN_UP=false
CRM_ALLOWED_EMAILS=SUBSTITUA_EMAIL_DO_OPERADOR
DOCUMENT_STORAGE_DRIVER=r2
R2_ENDPOINT=https://SUBSTITUA_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=55marcas-documentos
R2_ACCESS_KEY_ID=SUBSTITUA
R2_SECRET_ACCESS_KEY=SUBSTITUA
MAX_DOCUMENT_SIZE_MB=10
SEARCH_DAILY_LIMIT=30
SEARCH_ENABLED=false
SEARCH_ATTEMPTS_PER_MINUTE=2
SEARCH_IP_HOURLY_LIMIT=10
SEARCH_WHATSAPP_DAILY_LIMIT=10
PUBLIC_READS_PER_MINUTE=60
PUBLIC_WRITES_PER_MINUTE=10
CLIENT_IP_MODE=railway
CLIENT_IP_VERIFIED=false
TURNSTILE_SECRET_KEY=SUBSTITUA
TURNSTILE_HOSTNAMES=55marcas.com.br,www.55marcas.com.br
# Habilite somente após seguir docs/protecao-consultas.md.
# A chave NEXT_PUBLIC_TURNSTILE_SITE_KEY é configurada no projeto da landing.
# PUBLIC_PROXY_SECRET é opcional: somente para proxies autenticados.
