{
  "name": "consulta-marcas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:operations": "bun run --cwd api-bun dev",
    "dev:crm": "bun run --cwd crm-web dev",
    "build": "vinext build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "vinext start",
    "dev:api": "wrangler dev --config wrangler-api.jsonc",
    "deploy:api": "wrangler deploy --config wrangler-api.jsonc",
    "secret:api": "wrangler secret put INFOSIMPLES_TOKEN --config wrangler-api.jsonc",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:generate:operations": "bun run --cwd api-bun db:generate",
    "db:migrate:operations": "bun run --cwd api-bun db:migrate",
    "typecheck:operations": "bun run --cwd api-bun typecheck",
    "typecheck:crm": "bun run --cwd crm-web typecheck",
    "admin:create": "bun run --cwd api-bun admin:create"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "railway": "^3.11.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
