DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flavio_marcas
INFOSIMPLES_TOKEN=seu_token_infosimples_aqui
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PORT=3100

# Defina um valor longo e aleatorio antes de publicar a API.
RATE_LIMIT_SALT=troque-por-um-valor-secreto

# Autenticação do CRM. Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3100

# Assina links públicos de propostas e contratos sem armazenar o token em texto puro.
PROPOSAL_LINK_SECRET=troque-por-outro-segredo-com-pelo-menos-32-caracteres

# Apenas estes e-mails poderão acessar os dados do CRM.
CRM_ALLOWED_EMAILS=voce@empresa.com

# Usados somente por `bun run admin:create`; remova a senha após o cadastro.
CRM_ADMIN_EMAIL=voce@empresa.com
CRM_ADMIN_NAME=Administrador
CRM_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Armazenamento local dos PDFs assinados recebidos pelo CRM (desenvolvimento).
DOCUMENT_STORAGE_DRIVER=local
# Em produção, use r2 e configure as quatro variáveis R2 abaixo.
DOCUMENT_STORAGE_DIR=./storage
MAX_DOCUMENT_SIZE_MB=10

# Configurações de produção: guia completo em ../deploy/PRODUCAO.md.
# DATABASE_MIGRATION_URL=URL_direta_do_Neon
# DATABASE_POOL_SIZE=3
# R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=55marcas-documentos
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Limite GLOBAL nas últimas 24h; inclui consultas que falharam.
# Padrão: 30 em produção; desabilitado no desenvolvimento.
# SEARCH_DAILY_LIMIT=30
# Desliga consultas pagas sem impedir o acesso ao CRM.
SEARCH_ENABLED=true
