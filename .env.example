# Copie este valor para .env e substitua pelo seu token real.
INFOSIMPLES_TOKEN=seu_token_infosimples_aqui
CORS_ORIGIN=http://localhost:3000

# Backend operacional Bun. Em desenvolvimento, a landing encaminha as rotas
# /api/consultas e /api/leads para este endereco.
OPERATIONS_API_URL=http://localhost:3100

# Use esta variavel apenas quando o navegador precisar falar diretamente com
# a API externa, como na exportacao estatica para GitHub Pages.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3100
